#!/bin/sh
# Print the timesheet binary (default) or the repository root (--root).
#
# The skill calls this helper from its own absolute directory. Symlinked skill
# paths are resolved first, so the repository is the one that owns the real
# script: <repo>/.agents/skills/timesheet/scripts/ts-env is four levels below
# the repository root. Fallbacks, in order: <repo>/bin/timesheet,
# $TIMESHEET_ROOT/bin/timesheet, a `timesheet` on PATH. This reads no
# configuration or environment-file values.

set -eu

want=binary
case "${1:-}" in
	"") ;;
	--root) want=root ;;
	*)
		echo "ts-env: unknown argument: $1 (expected --root)" >&2
		exit 2
		;;
esac

script=$0
case $script in
	*/*) ;;
	*)
		script=$(command -v "$script" 2>/dev/null) || {
			echo "ts-env: cannot locate itself on PATH" >&2
			exit 1
		}
		;;
esac

# Resolve a symlinked script path without relying on GNU readlink -f.
links=0
while [ -h "$script" ]; do
	dir=$(CDPATH= cd "$(dirname "$script")" && pwd -P) || exit 1
	link=$(readlink "$script") || exit 1
	case $link in
		/*) script=$link ;;
		*) script=$dir/$link ;;
	esac
	links=$((links + 1))
	if [ "$links" -gt 40 ]; then
		echo "ts-env: too many symlinks resolving the script path" >&2
		exit 1
	fi
done
script_dir=$(CDPATH= cd "$(dirname "$script")" && pwd -P) || exit 1

# scripts -> timesheet -> skills -> .agents -> repository.
repo=$(CDPATH= cd "$script_dir/../../../.." 2>/dev/null && pwd -P) || repo=

root=$repo
if [ -z "$root" ] || [ ! -d "$root" ]; then
	root=${TIMESHEET_ROOT:-}
fi

if [ "$want" = root ]; then
	if [ -z "$root" ]; then
		echo "ts-env: cannot locate the repository; set TIMESHEET_ROOT" >&2
		exit 1
	fi
	printf '%s\n' "$root"
	exit 0
fi

if [ -n "$repo" ] && [ -x "$repo/bin/timesheet" ]; then
	printf '%s\n' "$repo/bin/timesheet"
	exit 0
fi
if [ -n "${TIMESHEET_ROOT:-}" ] && [ -x "$TIMESHEET_ROOT/bin/timesheet" ]; then
	printf '%s\n' "$TIMESHEET_ROOT/bin/timesheet"
	exit 0
fi
if found=$(command -v timesheet 2>/dev/null) && [ -n "$found" ]; then
	printf '%s\n' "$found"
	exit 0
fi

echo "ts-env: no timesheet binary found; build one with 'go build -trimpath -o bin/timesheet ./cmd/timesheet' or set TIMESHEET_ROOT" >&2
exit 1
