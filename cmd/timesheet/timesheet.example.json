{
  "timezone": "Europe/Amsterdam",
  "state_path": "/Users/example/.timesheet/state.json",
  "projects": [
    {
      "id": "SYN-1",
      "name": "Synthetic Project",
      "default_classification": "DEV"
    },
    {
      "id": "SYN-2",
      "name": "Second Synthetic Project",
      "default_classification": "OPS"
    }
  ],
  "required_env": [
    "GITHUB_TOKEN",
    "GCAL_ICS_URL"
  ],
  "sources": {
    "enabled": true,
    "github": {
      "enabled": true,
      "user": "synthetic-user",
      "repositories": [
        "example-org/example-repo"
      ],
      "api_base": "https://api.github.com"
    },
    "calendar": {
      "enabled": true,
      "user": "synthetic@example.invalid"
    }
  },
  "migration": {
    "enabled": false,
    "legacy_root": "/Users/example/.timesheet/legacy-records",
    "legacy_timezone": "Europe/Amsterdam"
  },
  "gradion": {
    "enabled": false,
    "endpoint": "https://mcp.example.invalid/mcp",
    "token_env": "GRADION_MCP_TOKEN",
    "default_classification": {
      "catalog_id": "synthetic-catalog-id",
      "classification_id": "synthetic-option-id",
      "code": "TRAIN",
      "name": "Synthetic training",
      "activity_type": "Learning"
    }
  }
}
