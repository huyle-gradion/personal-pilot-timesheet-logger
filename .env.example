# Example environment file for the timesheet.
#
# The compiled binary reads a launcher-supplied --env-file path. The model and
# the Pi adapter must never read this file. Values below are placeholders only.
#
# R1 (0.1.0-dev.1) is a local review workflow and requires NO credentials.
# R2 (0.1.0-dev.4) adds binary-owned GitHub and calendar collection. Both
# credential names below are only required by the collection dispatch when the
# corresponding source is enabled in configuration (sources.github / sources
# .calendar); with sources disabled the workflow stays manual-only and these
# values are never used.
#
# Precedence (R1): inherited process environment values override file values
# for the same name, including explicitly empty values.
#
# Supported syntax: KEY=VALUE, # comments, single-quoted literal values, and
# double-quoted values with \\ \" \n \t escapes. Command substitution,
# variable expansion, `export`, and sourcing are not supported.

# R2 GitHub evidence collector. Only the compiled binary reads it and uses it
# as a Bearer credential for the GitHub REST API (or the trusted configured
# api_base when verification points at a private local service).
GITHUB_TOKEN="replace-with-placeholder-token"

# R2 private calendar feed. Only the compiled binary resolves the URL and
# fetches the feed; it must never be stored in configuration and never echoed
# in errors, logs, state, or reports.
GCAL_ICS_URL="https://calendar.example.invalid/private/placeholder/basic.ics"

# R3 read-only Gradion MCP credential. Only the compiled binary resolves this
# name and value through the documented dotenv/inherited precedence; it is used
# as a Bearer credential for the configured read-only MCP endpoint. The value is
# never echoed in errors, receipts, state or reports. The variable NAME is
# configurable (gradion.token_env); the default is GRADION_MCP_TOKEN. R3 calls
# only timesheet__get_my_week and timesheet__get_classifications and has no
# write, approval or submission operation.
GRADION_MCP_TOKEN="replace-with-placeholder-token"

# R3 migration has no credential of its own. It reads legacy workflow records
# from a launcher-provisioned local root; only the compiled binary reads them.

# Optional synthetic/test variable names may be declared in the config file's
# required_env list. Only names are ever reported, never values.
